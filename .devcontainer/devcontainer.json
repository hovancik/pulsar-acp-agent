{
  "name": "Pulsar ACP Agent",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/pulsar-acp-agent,type=bind",
  "workspaceFolder": "/home/vscode/pulsar-acp-agent",
  "containerUser": "vscode",
  "init": true,
  "runArgs": ["--cap-drop=ALL"],
  "securityOpt": ["no-new-privileges:true"],
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "none",
      "nodeGypDependencies": false,
      "pnpmVersion": "none"
    }
  },
  "containerEnv": {
    "DISPLAY": "disabled"
  },
  "mounts": [
    "source=${devcontainerId}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "postCreateCommand": ["bash", ".devcontainer/setup.sh"],
  "waitFor": "postCreateCommand"
}
