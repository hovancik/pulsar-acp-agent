{
  "name": "pulsar-acp-agent",
  "main": "./lib/main.js",
  "version": "0.1.0",
  "description": "Bring your own AI coding agent to Pulsar via the Agent Client Protocol (ACP).",
  "keywords": [
    "acp",
    "agent",
    "ai",
    "copilot",
    "assistant"
  ],
  "license": "BSD-2-Clause",
  "engines": {
    "atom": ">=1.132.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hovancik/pulsar-acp-agent.git"
  },
  "bugs": {
    "url": "https://github.com/hovancik/pulsar-acp-agent/issues"
  },
  "homepage": "https://github.com/hovancik/pulsar-acp-agent#readme",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "styles",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "activationCommands": {
    "atom-workspace": [
      "pulsar-acp-agent:toggle",
      "pulsar-acp-agent:focus"
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^0.25.0",
    "@types/atom": "npm:@pulsar-edit/types@^1.132.0",
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.3",
    "zod": "^3.25.76"
  },
  "configSchema": {
    "command": {
      "type": "string",
      "default": "copilot",
      "order": 1,
      "title": "Agent command",
      "description": "Executable that speaks ACP over stdio. For GitHub Copilot CLI this is `copilot`."
    },
    "args": {
      "type": "array",
      "default": [
        "--acp",
        "--stdio"
      ],
      "order": 2,
      "title": "Agent arguments",
      "description": "Arguments passed to the agent command. Defaults match GitHub Copilot CLI's ACP server.",
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string",
      "default": "",
      "order": 3,
      "title": "Working directory",
      "description": "Absolute path used as the session working directory. Leave blank to use the first open project folder."
    }
  }
}
